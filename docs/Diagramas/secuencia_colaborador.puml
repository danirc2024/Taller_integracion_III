@startuml Diagrama_Secuencia_Usuario_Colaborador
skinparam Style StrictUml
skinparam SequenceMessageAlignment center
skinparam DatabaseBackgroundColor #E1F5FE
skinparam ParticipantBackgroundColor #FFF9C4

actor "Usuario Colaborador" as Colab
participant "Frontend Web (React)" as UI
participant "API Gateway (FastAPI)" as API
database "PostgreSQL / PostGIS" as DB
participant "Servicio IA Conversacional" as AI
participant "Motor de Rutas (OSRM)" as RouteEngine

autonumber 400

box "1. Login, Perfil de Colaborador y Carrito (ucLogin, ucPerfil, ucCarrito)" #E8EAF6
    Colab -> UI : 1. Inicia sesión (email, password)
    UI -> API : POST /api/v1/auth/login
    API -> DB : Validar credenciales, rol Colaborador, rango máx. y saldo de tokens IA
    DB --> API : Datos de usuario autenticado + Estado Colaborador
    API --> UI : 200 OK (JWT Token + Perfil Colaborador)
    
    UI -> API : GET /api/v1/carrito (Obtener lista guardada)
    API -> DB : SELECT * FROM cart_items WHERE user_id = ...
    DB --> API : Lista de compras activa
    API --> UI : 200 OK (Items del Carrito)
    UI --> Colab : Despliega Dashboard con Carrito, Perfil y Rango Colaborador
end box

box "2. Completar Misiones de Validación de Precios, Stock y Gastos (ucMisionesVal / RF-02.3)" #FFF9C4
    Colab -> UI : 2. Envía reporte de validación (Precio real en tienda, Stock, Gasto transporte)
    UI -> API : POST /api/v1/colaborador/misiones/completar (sucursal_id, producto_id, precio_reportado, ev_foto)
    API -> DB : INSERT INTO misiones_completadas (...) + UPDATE capturas_precios / feedback
    DB --> API : Misión registrada exitosamente (ID Misión)
    
    API -> DB : UPDATE usuarios SET cuota_tokens_ia = cuota_tokens_ia + bonus_mision
    DB --> API : Nuevo saldo incrementado de tokens IA acreditado
    
    API --> UI : 200 OK (Misión Completada + Bonus de Tokens IA Acreditado)
    UI --> Colab : Notifica "¡Misión Validada! +500 Tokens de IA otorgados a tu cuota"
end box

box "3. Asistente IA Conversacional con Cuota Ampliada (ucIA, ucReemplazo / RF-02.4)" #F3E5F5
    Colab -> UI : 3. Solicita recomendación avanzada de recetas / reemplazos
    UI -> API : POST /api/v1/ia/chat (prompt, jwt_token)
    API -> DB : Verificar cuota incrementada de tokens IA y perfil dietético
    DB --> API : Saldo tokens activo OK + Restricciones dietéticas
    
    API -> AI : Consultar LLM (Prompt + Contexto Catálogo + Perfil Dietético)
    AI -> AI : Filtrar por perfil dietético y generar respuesta estructurada
    AI --> API : Respuesta recomendada (Receta + Ingredientes + Tiendas)
    API --> UI : 200 OK (Recomendación IA)
    UI --> Colab : Muestra receta/ingredientes y opción "Agregar al Carrito"
end box

box "4. Optimización de Ruta de Compra y Traslado (ucRuta, ucHorarios, Costos)" #E8F5E9
    Colab -> UI : 4. Solicita "Optimizar Ruta" (Medio de Traslado: Auto/Bus/Caminata)
    UI -> API : POST /api/v1/rutas/optimizar (cart_id, medio_traslado, coords_origen, max_rango)
    API -> API : Validar ubicación de origen y estado de tiendas
    API -> DB : Obtener catálogo, stock verificado y precios por sucursal dentro del rango
    DB --> API : Precios por tienda y ubicaciones
    
    API -> RouteEngine : POST /solve-tsp (Matriz de distancias OSRM, tiendas, costo traslado)
    RouteEngine -> RouteEngine : Calcular TSP, costo de traslado vs costo de canasta (Única vs Multitienda)
    RouteEngine --> API : Ruta óptima (Matriz de paradas, horarios de atención, ahorro neto)
    
    API --> UI : 200 OK (JSON Ruta, Geometría GeoJSON y Desglose de Ahorro)
    UI --> Colab : Despliega Mapa Interactivo con el trazado de ruta y desglose de ahorro
end box

box "5. Consultar Estado y Beneficios de Colaborador (ucBeneficiosColab / RF-02.4)" #FFFDE7
    Colab -> UI : 5. Abre Panel de Estado de Colaborador
    UI -> API : GET /api/v1/colaborador/estado (jwt_token)
    API -> DB : SELECT nivel_misiones, tiempo_restante_rango, tokens_bonus FROM perfil_colaborador WHERE user_id = ...
    DB --> API : Métricas de colaborador y saldo de tokens
    
    API --> UI : 200 OK (JSON Nivel, Tiempo Restante de Rango y Saldo Tokens IA)
    UI --> Colab : Despliega nivel de misiones, días restantes de beneficio y saldo IA incrementado
end box

@enduml
